# Crew dispatch (package sgw.dispatch), D-100 Q-03 C: a dispatcher assigns a crew to an open decision or a
# staging yard, and one person of the signing function signs it before the crew moves. Data:
# data.sgw.crew_dispatch (generated by sgw.dispatch.policy). Decisions are deny-lists; anything undefined denies.
package sgw.dispatch

cfg := data.sgw.crew_dispatch

roles := object.get(input, ["subject", "roles"], [])

functions := object.get(input, ["subject", "functions"], [])

assignment := object.get(input, "assignment", {})

is_actor if {
	some role in roles
	role in cfg.actor_roles
}

signer_candidates := [f | some f in cfg.signer_functions; not f in functions]

default required_function := null

required_function := signer_candidates[0] if count(signer_candidates) > 0

act_deny contains "role_not_allowed" if not is_actor

act := {
	"allow": count(act_deny) == 0,
	"deny": sort(act_deny),
}

propose_deny contains reason if some reason in act_deny

propose_deny contains "no_signer_function" if required_function == null

propose := {
	"allow": count(propose_deny) == 0,
	"deny": sort(propose_deny),
	"required_function": required_function,
	"policy_version": cfg.policy_version,
}

sign_deny contains "not_pending" if not object.get(assignment, "state", null) in cfg.open_states

sign_deny contains "self_sign" if input.subject.user_id == assignment.proposed_by

sign_deny contains "not_an_approver" if not input.subject.can_approve == true

sign_deny contains "off_shift" if input.subject.on_shift == false

sign_deny contains "function_not_held" if not object.get(assignment, "required_function", null) in functions

sign := {
	"allow": count(sign_deny) == 0,
	"deny": sort(sign_deny),
}
