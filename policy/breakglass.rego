# Break-glass and co-sign (package sgw.breakglass), PLAN section 2: on a T3 action the IC alone may act,
# with a mandatory reason; a holder of the second required function co-signs within the window; every use
# is flagged for the after-action review. Data: data.sgw.governance (generated by
# sgw.approval.breakglass_policy). Decisions are deny-lists; anything undefined denies.
package sgw.breakglass

cfg := data.sgw.governance.break_glass

default reason_chars := 0

reason_chars := count(trim_space(input.break_glass.reason)) if is_string(input.break_glass.reason)

break_glass_deny contains "not_break_glass_tier" if not input.proposal.tier in cfg.tiers

break_glass_deny contains "reason_too_short" if reason_chars < cfg.reason_min_chars

break_glass_deny contains "not_eligible" if not input.subject.break_glass_eligible == true

break_glass_deny contains "function_not_held" if not cfg.eligible_function in input.subject.functions

break_glass_deny contains "off_shift" if input.subject.on_shift == false

break_glass_deny contains "not_open" if not input.proposal.state in cfg.open_states

break_glass_deny contains "expired" if {
	is_number(input.proposal.expires_at_ns)
	input.context.now_ns >= input.proposal.expires_at_ns
}

break_glass_deny contains "already_used" if input.break_glass.existing == true

break_glass_deny contains "ic_is_proposer" if input.subject.user_id == input.proposal.proposed_by

break_glass := {
	"allow": count(break_glass_deny) == 0,
	"deny": sort(break_glass_deny),
}

# ---- co-sign -------------------------------------------------------------------------------------------

second_functions contains f if {
	some f in input.proposal.required_functions
	f != cfg.eligible_function
	f in input.subject.functions
}

cosign_deny contains "not_an_approver" if not input.subject.can_approve == true

cosign_deny contains "off_shift" if input.subject.on_shift == false

cosign_deny contains "cosigner_is_ic" if input.subject.user_id == input.break_glass.ic_id

cosign_deny contains "cosigner_is_proposer" if input.subject.user_id == input.proposal.proposed_by

cosign_deny contains "no_second_function" if count(second_functions) == 0

cosign_deny contains "already_cosigned" if input.break_glass.cosigned == true

cosign_deny contains "not_cosignable" if not input.proposal.state in cfg.cosign_states

default cosign_function := ""

cosign_function := sort(second_functions)[0] if count(second_functions) > 0

cosign := {
	"allow": count(cosign_deny) == 0,
	"deny": sort(cosign_deny),
	"function": cosign_function,
}
