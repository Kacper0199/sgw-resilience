# OPA server authorization (--authentication=token --authorization=basic).
# Clients on the app network may only evaluate decisions (POST /v1/data/...) with the shared bearer token
# generated by `sgw bootstrap` (var/secrets/opa.env). Policies and data are files mounted read-only; every
# write through the REST API (PUT/PATCH/DELETE on /v1/policies or /v1/data) and every other endpoint is denied.
package system.authz

import rego.v1

default allow := false

allow if {
	input.method == "GET"
	input.path == ["health"]
}

allow if {
	input.method == "POST"
	count(input.path) > 2
	input.path[0] == "v1"
	input.path[1] == "data"
	not input.path[2] == "system"
	valid_token
}

valid_token if {
	expected := object.get(opa.runtime().env, "SGW_OPA_TOKEN", "")
	count(expected) >= 32
	input.identity == expected
}
