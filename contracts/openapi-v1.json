{
  "openapi": "3.1.0",
  "info": {
    "title": "SGW Resilience Decision Platform Integration API",
    "version": "1.0.0+schema1",
    "description": "Versioned read API, webhook subscriptions and an SSE subscription for external systems. Authenticate with `Authorization: Bearer sgwi_...` (scoped, expiring, revocable). No scope can approve a decision."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "apiToken": []
    }
  ],
  "paths": {
    "/api/admin/tokens": {
      "post": {
        "operationId": "createApiToken",
        "tags": [
          "admin"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiTokenCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiTokenCreated"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listApiTokens",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiTokenOut"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/tokens/{token_id}": {
      "delete": {
        "operationId": "revokeApiToken",
        "tags": [
          "admin"
        ],
        "description": "Revokes the token and disables its webhook subscriptions.",
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "OK"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/commitments": {
      "get": {
        "operationId": "v1ListCommitments",
        "tags": [
          "integration"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommitmentV1"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/decisions": {
      "get": {
        "operationId": "v1ListDecisions",
        "tags": [
          "integration"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DecisionV1"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/decisions/{decision_case_id}": {
      "get": {
        "operationId": "v1GetDecision",
        "tags": [
          "integration"
        ],
        "parameters": [
          {
            "name": "decision_case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionV1"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "v1StreamEvents",
        "tags": [
          "integration"
        ],
        "description": "Server-sent events of the webhook event types the token may read. Frames: `id: v1.<epoch>.<seq>`, `event: <type>`, `data: <WebhookEventV1>`; `Last-Event-ID` resumes from the ledger; an id the server cannot honour gets one `event: resync` frame. Comment heartbeats every 10 s; a revoked or expired token ends the stream.",
        "parameters": [
          {
            "name": "types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of WebhookEventV1",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEventV1"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden by policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/webhooks": {
      "post": {
        "operationId": "v1CreateWebhook",
        "tags": [
          "integration"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookSubscriptionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSubscriptionV1"
                }
              }
            },
            "headers": {
              "SGW-Webhook-Secret": {
                "description": "the signing secret, shown once (the body carries only its last 4 characters)",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      },
      "get": {
        "operationId": "v1ListWebhooks",
        "tags": [
          "integration"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookSubscriptionV1"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/webhooks/{subscription_id}": {
      "delete": {
        "operationId": "v1DeleteWebhook",
        "tags": [
          "integration"
        ],
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "OK"
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/webhooks/{subscription_id}/deliveries": {
      "get": {
        "operationId": "v1ListWebhookDeliveries",
        "tags": [
          "integration"
        ],
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookDeliveryV1"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    },
    "/v1/webhooks/{subscription_id}/rotate-secret": {
      "post": {
        "operationId": "v1RotateWebhookSecret",
        "tags": [
          "integration"
        ],
        "description": "Adds a new signing secret; the previous one keeps signing for `overlap_s` seconds.",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "overlap_s",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800,
              "default": 86400
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSecretRotated"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiToken": []
          }
        ]
      }
    }
  },
  "webhooks": {
    "ClockBreached": {
      "post": {
        "operationId": "webhookClockBreached",
        "summary": "ClockBreached (needs scope clocks:read)",
        "description": "Signed POST to the subscription URL. `SGW-Signature: t=<unix s>,v1=<hex>`[,v1=...] with v1 = HMAC-SHA256(secret, `<t>.<SGW-Webhook-Id>.<raw body>`), one v1 per active secret during rotation. Reject timestamps more than 300 s from your clock and de-duplicate on `SGW-Webhook-Id` (stable across retries). Answer 2xx within 10 s; anything else is retried with exponential backoff and dead-lettered after 8 attempts; 410 disables the subscription.",
        "parameters": [
          {
            "name": "SGW-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Attempt",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "const": "SGW-Webhooks/1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/WebhookEventV1"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "ClockBreached"
                      },
                      "data": {
                        "$ref": "#/components/schemas/ClockBreached"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Accepted by the receiver"
          }
        }
      }
    },
    "CommitmentCreated": {
      "post": {
        "operationId": "webhookCommitmentCreated",
        "summary": "CommitmentCreated (needs scope commitments:read)",
        "description": "Signed POST to the subscription URL. `SGW-Signature: t=<unix s>,v1=<hex>`[,v1=...] with v1 = HMAC-SHA256(secret, `<t>.<SGW-Webhook-Id>.<raw body>`), one v1 per active secret during rotation. Reject timestamps more than 300 s from your clock and de-duplicate on `SGW-Webhook-Id` (stable across retries). Answer 2xx within 10 s; anything else is retried with exponential backoff and dead-lettered after 8 attempts; 410 disables the subscription.",
        "parameters": [
          {
            "name": "SGW-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Attempt",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "const": "SGW-Webhooks/1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/WebhookEventV1"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "CommitmentCreated"
                      },
                      "data": {
                        "$ref": "#/components/schemas/CommitmentCreated"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Accepted by the receiver"
          }
        }
      }
    },
    "CommitmentDrifted": {
      "post": {
        "operationId": "webhookCommitmentDrifted",
        "summary": "CommitmentDrifted (needs scope commitments:read)",
        "description": "Signed POST to the subscription URL. `SGW-Signature: t=<unix s>,v1=<hex>`[,v1=...] with v1 = HMAC-SHA256(secret, `<t>.<SGW-Webhook-Id>.<raw body>`), one v1 per active secret during rotation. Reject timestamps more than 300 s from your clock and de-duplicate on `SGW-Webhook-Id` (stable across retries). Answer 2xx within 10 s; anything else is retried with exponential backoff and dead-lettered after 8 attempts; 410 disables the subscription.",
        "parameters": [
          {
            "name": "SGW-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Attempt",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "const": "SGW-Webhooks/1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/WebhookEventV1"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "CommitmentDrifted"
                      },
                      "data": {
                        "$ref": "#/components/schemas/CommitmentDrifted"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Accepted by the receiver"
          }
        }
      }
    },
    "DecisionApproved": {
      "post": {
        "operationId": "webhookDecisionApproved",
        "summary": "DecisionApproved (needs scope decisions:read)",
        "description": "Signed POST to the subscription URL. `SGW-Signature: t=<unix s>,v1=<hex>`[,v1=...] with v1 = HMAC-SHA256(secret, `<t>.<SGW-Webhook-Id>.<raw body>`), one v1 per active secret during rotation. Reject timestamps more than 300 s from your clock and de-duplicate on `SGW-Webhook-Id` (stable across retries). Answer 2xx within 10 s; anything else is retried with exponential backoff and dead-lettered after 8 attempts; 410 disables the subscription.",
        "parameters": [
          {
            "name": "SGW-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SGW-Webhook-Attempt",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "const": "SGW-Webhooks/1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/WebhookEventV1"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "DecisionApproved"
                      },
                      "data": {
                        "$ref": "#/components/schemas/DecisionApproved"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Accepted by the receiver"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiScope": {
        "enum": [
          "decisions:read",
          "clocks:read",
          "commitments:read",
          "webhooks:manage"
        ],
        "title": "ApiScope",
        "type": "string"
      },
      "ApiTokenCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ApiScope"
            },
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "scopes",
          "expires_at"
        ],
        "title": "ApiTokenCreate",
        "type": "object"
      },
      "ApiTokenCreated": {
        "additionalProperties": false,
        "properties": {
          "token_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Token Id",
            "type": "string"
          },
          "token": {
            "description": "shown once; stored only as SHA-256",
            "title": "Token",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ApiScope"
            },
            "title": "Scopes",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "token",
          "scopes",
          "expires_at"
        ],
        "title": "ApiTokenCreated",
        "type": "object"
      },
      "ApiTokenOut": {
        "additionalProperties": false,
        "properties": {
          "token_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Token Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ApiScope"
            },
            "title": "Scopes",
            "type": "array"
          },
          "created_by": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Created By",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "required": [
          "token_id",
          "name",
          "scopes",
          "created_by",
          "created_at",
          "expires_at",
          "revoked_at",
          "last_used_at"
        ],
        "title": "ApiTokenOut",
        "type": "object"
      },
      "ClockBreached": {
        "additionalProperties": false,
        "properties": {
          "decision_case_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Decision Case Id",
            "type": "string"
          },
          "proposal_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Proposal Id"
          },
          "effective_decide_by_utc": {
            "format": "date-time",
            "title": "Effective Decide By Utc",
            "type": "string"
          },
          "breached_at_utc": {
            "format": "date-time",
            "title": "Breached At Utc",
            "type": "string"
          },
          "clock_kind": {
            "$ref": "#/components/schemas/ClockKind"
          }
        },
        "required": [
          "decision_case_id",
          "effective_decide_by_utc",
          "breached_at_utc",
          "clock_kind"
        ],
        "title": "ClockBreached",
        "type": "object"
      },
      "ClockKind": {
        "enum": [
          "rule_deadline",
          "model_estimate"
        ],
        "title": "ClockKind",
        "type": "string"
      },
      "CommitmentCreated": {
        "additionalProperties": false,
        "properties": {
          "commitment_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Commitment Id",
            "type": "string"
          },
          "decision_case_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "title": "Decision Case Id",
            "type": "string"
          },
          "proposal_id": {
