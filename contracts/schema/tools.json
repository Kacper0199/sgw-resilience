{
  "get_risk": {
    "meta": {
      "name": "get_risk",
      "tier_ceiling": "T0",
      "reads_classes": [
        "C0",
        "C1",
        "C2"
      ],
      "side_effect": "none",
      "model_visible": true,
      "returns_search_results": false
    },
    "args": {
      "$defs": {
        "Domain": {
          "enum": [
            "electric",
            "water"
          ],
          "title": "Domain",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "county",
            "h3",
            "asset"
          ],
          "title": "Level",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Entity Ids",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Domain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "level"
      ],
      "title": "GetRiskArgs",
      "type": "object"
    },
    "result": {
      "$defs": {
        "RiskBand": {
          "enum": [
            "very_low",
            "low",
            "moderate",
            "high",
            "very_high"
          ],
          "title": "RiskBand",
          "type": "string"
        },
        "RiskRow": {
          "additionalProperties": false,
          "properties": {
            "entity_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
              "title": "Entity Id",
              "type": "string"
            },
            "p_ppm": {
              "description": "probability or share in parts per million",
              "maximum": 1000000,
              "minimum": 0,
              "title": "P Ppm",
              "type": "integer"
            },
            "band": {
              "$ref": "#/$defs/RiskBand"
            },
            "evidence_id": {
              "title": "Evidence Id",
              "type": "string"
            }
          },
          "required": [
            "entity_id",
            "p_ppm",
            "band",
            "evidence_id"
          ],
          "title": "RiskRow",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/RiskRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "snapshot_id"
      ],
      "title": "GetRiskResult",
      "type": "object"
    }
  },
