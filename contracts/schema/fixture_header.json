{
  "$defs": {
    "FeedMode": {
      "enum": [
        "live",
        "replay",
        "synthetic"
      ],
      "title": "FeedMode",
      "type": "string"
    },
    "ScenarioWindow": {
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        },
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        }
      },
      "required": [
        "start_utc",
        "end_utc"
      ],
      "title": "ScenarioWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fixture": {
      "title": "Fixture",
      "type": "string"
    },
    "schema_version": {
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "feed": {
      "title": "Feed",
      "type": "string"
    },
    "feed_mode": {
      "$ref": "#/$defs/FeedMode"
    },
    "generator": {
      "title": "Generator",
      "type": "string"
    },
    "generator_version": {
      "title": "Generator Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Seed"
    },
    "calibration_source": {
      "title": "Calibration Source",
      "type": "string"
    },
    "scenario_window": {
      "$ref": "#/$defs/ScenarioWindow"
    },
    "licence": {
      "title": "Licence",
      "type": "string"
    },
    "body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Body Sha256",
      "type": "string"
    },
    "hand_made": {
      "default": false,
      "title": "Hand Made",
      "type": "boolean"
    },
    "data_label": {
      "default": "synthetic",
      "enum": [
        "synthetic",
        "public",
        "mixed"
      ],
      "title": "Data Label",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "fixture",
    "schema_version",
    "feed",
    "feed_mode",
    "generator",
    "generator_version",
    "seed",
    "calibration_source",
    "scenario_window",
    "licence",
    "body_sha256"
  ],
  "title": "SGW K9 fixture header",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
