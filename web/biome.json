{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/src/contracts/*.gen.ts",
      "!**/public/mockServiceWorker.js",
      "!**/src/features/map/geo/*.json",
      "!**/public/geo/*.json",
      "!**/src/features/*/mock/*.json",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.playwright-cli"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
