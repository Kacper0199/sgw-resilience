        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sgw-prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, route) (rate(sgw_http_request_duration_seconds_bucket{route!~\"/(healthz|readyz)\"}[5m]))))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
