\ProvidesPackage{sgwdiagrams}[2026/11/19 Shared TikZ styles for SGW diagrams (DESIGN.md palette, flat)]
% Every style lives under the sgw/ key family, so no style can shadow a TikZ key
% (the starter's bare style names, such as out, collided with to-path options).
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric,arrows.meta,positioning,fit,backgrounds,calc}
\InputIfFileExists{sgwpalette.tex}{}{\PackageError{sgwdiagrams}{sgwpalette.tex missing}{Run uv run python docs/figures/style.py --tex}}

\tikzset{
  sgw/.style={font=\footnotesize\sffamily,text=sgwInk,execute at begin node={\hyphenpenalty=10000\relax\exhyphenpenalty=10000\relax},node distance=0.55cm and 0.9cm,>={Latex[length=2mm]},line join=round},
  sgw/box/.style={rectangle,draw=sgwHairline,line width=0.6pt,fill=sgwSurface,rounded corners=2pt,align=center,
    minimum height=0.8cm,minimum width=2.1cm,inner sep=3pt},
  sgw/service/.style={sgw/box,draw=sgwPrimary,line width=0.8pt},
  sgw/core/.style={sgw/box,draw=sgwPrimary,fill=sgwPrimary,text=sgwOnPrimary,font=\footnotesize\sffamily\bfseries},
  sgw/external/.style={sgw/box,dashed,draw=sgwInkMuted,text=sgwInkMuted},
  sgw/source/.style={sgw/box,fill=sgwNeutral},
  sgw/store/.style={cylinder,shape border rotate=90,aspect=0.2,draw=sgwPrimary,line width=0.8pt,fill=sgwSevAdvisoryFill,
    align=center,minimum height=1.05cm,minimum width=2.1cm,inner sep=2pt},
  sgw/person/.style={rectangle,rounded corners=7pt,draw=sgwSecondary,line width=0.8pt,fill=sgwSurface,align=center,
    minimum height=0.7cm,inner sep=3pt,font=\footnotesize\sffamily\bfseries,text=sgwSecondary},
  sgw/gate/.style={diamond,aspect=1.8,draw=sgwSevCritical,line width=0.8pt,fill=sgwSevCriticalFill,align=center,inner sep=1pt},
  sgw/decision/.style={sgw/box,draw=sgwSecondary,line width=0.9pt,fill=sgwSevAdvisoryFill},
  sgw/consequence/.style={sgw/box,draw=sgwSevCritical,line width=0.9pt,fill=sgwSevCriticalFill},
  sgw/ok/.style={sgw/box,fill=sgwOkFill},
  sgw/chip/.style={rectangle,rounded corners=1.5pt,fill=sgwNeutral,draw=sgwHairline,inner sep=2pt,
    font=\scriptsize\ttfamily,text=sgwInk},
  sgw/flow/.style={->,line width=0.8pt,draw=sgwInk},
  sgw/flow muted/.style={->,line width=0.6pt,draw=sgwInkMuted},
  sgw/critical/.style={->,line width=1.1pt,dashed,draw=sgwSevCritical},
  sgw/feedback/.style={->,line width=0.6pt,dashed,draw=sgwInkMuted},
  sgw/note/.style={font=\scriptsize\sffamily,text=sgwInkMuted,align=center},
  sgw/zone/.style={draw=sgwHairline,line width=0.6pt,fill=#1,rounded corners=3pt,inner sep=8pt},
  sgw/zone/.default=sgwNeutral,
  sgw/zone title/.style={font=\scriptsize\sffamily\bfseries,anchor=south west,inner sep=1pt,text=sgwInkMuted},
  sgw/lane/.style={fill=#1,draw=none},
  sgw/lane/.default=sgwNeutral,
}

% \sgwzone{name}{fill colour}{fit list}{title}: call inside a tikzpicture, after the nodes.
\newcommand{\sgwzone}[4]{%
  \begin{pgfonlayer}{background}\node[sgw/zone=#2,fit=#3] (#1) {};\end{pgfonlayer}
  \node[sgw/zone title] at ([xshift=2pt,yshift=1pt]#1.north west) {#4};}

% Roadmap helpers: x in months, row 0 at the top.
\newcommand{\sgwphase}[5][sgwPrimary]{% [colour]{row}{start}{end}{label}
  \fill[#1,rounded corners=1pt] (#3,-#2-0.84) rectangle (#4,-#2-0.16);
  \node[font=\scriptsize\sffamily,text=white,anchor=center] at ({(#3+#4)/2},-#2-0.5) {#5};}
\newcommand{\sgwgatemark}[3]{% {row}{time}{label}
  \node[diamond,fill=sgwSevCritical,draw=white,inner sep=2.2pt] at (#2,-#1-0.5) {};
  \node[font=\scriptsize\sffamily,anchor=west,text=sgwInk] at (#2+0.2,-#1-0.5) {#3};}
\newcommand{\sgwrowlabel}[2]{\node[font=\scriptsize\sffamily\bfseries,anchor=east,text=sgwInk] at (-0.15,-#1-0.5) {#2};}


% Second line of a node label, muted: Name\sgwsub{detail}
\newcommand{\sgwsub}[1]{\\[-1pt]{\scriptsize\mdseries\color{sgwInkMuted}#1}}
