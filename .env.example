# Template only: copy to .env and fill in locally; never commit real values.
# Containers get their credentials from `uv run sgw bootstrap` (var/, git-ignored), not from this file.

# LLM gateway only (live mode); empty means replay.
ANTHROPIC_API_KEY=

# Integration API (WP-37). The master key (64 hex characters) is generated by `uv run sgw bootstrap` into
# var/secrets/integration.key and passed to the api and webhooks services; set it here only to override.
SGW_INTEGRATION_KEY=
# Comma-separated host:port pairs the webhook worker may deliver to although they resolve to private
# addresses (e.g. a local consumer such as 127.0.0.1:8701); empty allows public HTTPS targets only.
SGW_WEBHOOK_ALLOW_HOSTS=
# Extra CA bundle (PEM path) the webhook worker trusts, for a consumer with a private CA.
SGW_WEBHOOK_CA_FILE=
