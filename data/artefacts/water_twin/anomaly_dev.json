{
 "baseline": "station low-pressure alarm alone (water.low_pressure_alarm_psi; no A8, no status check)",
 "command": "uv run sgw water anomaly",
 "label": "synthetic",
 "limitations": [
  "replayed_sequence needs 8 equal readings: a 1.5-3 h level replay at 30-min sampling gives 3-6 readings, so steady-state level replays are missed; a 4-reading window would cost about 0.07^4 x 336 lags x 48 windows = 0.4 chance matches per sensor-day (40 per 100 asset-days), far above the 1/100 target, so the window stays at 8 and this is a documented limitation",
  "a leak while the tank is held full by the pump changes neither pressure nor level; it needs flow metering",
  "pairwise A8 alarms cannot say which of the two sensors is wrong (except with a third sensor)"
 ],
 "post_hoc_subset": "recall_physically_detectable and spoof_consequential are a post-hoc subset, defined after the first bench run from the true state with margins taken from the detector's own settings (0.5 / 1.5 ft level band, 4 windows before and 2 after a leak, 3 sigma for a replay); context only, never a pass",
 "quoted_metric": "raw recall over every seeded fault (passed_raw); nothing else is a pass criterion",
